# Accès en lecture à l'entrepôt de données (Trino, OVH Data Platform)
OVH_API_KEY=
OVH_SECRET_KEY=

# Accès à l'API IAnord Data Bridge (page "Comparaison Prod")
DATABRIDGE_URL=
CLIENT_KEY=
CLIENT_SECRET=

# Basic Auth de la passerelle placée devant l'API en production (protège
# toutes les routes, en plus du token applicatif ci-dessus)
DATABRIDGE_BASIC_AUTH_USER=
DATABRIDGE_BASIC_AUTH_PASSWORD=
